{
  "name": "purple-videos",
  "version": "1.0.0",
  "description": "Vidéo TikTok de Purple (1080×1920, 60 i/s, 20 s) réalisée avec Remotion",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.542",
    "@remotion/google-fonts": "4.0.542",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.542"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.542",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render PurpleTikTok out/purple-tiktok.mp4",
    "render:accroche2": "remotion render PurpleTikTok-Accroche2 out/purple-tiktok-accroche-2.mp4",
    "render:accroche3": "remotion render PurpleTikTok-Accroche3 out/purple-tiktok-accroche-3.mp4",
    "render:all": "npm run render && npm run render:accroche2 && npm run render:accroche3",
    "stills": "node scripts/stills.mjs --fin && node scripts/stills.mjs --fin --zones",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  },
  "allowScripts": {
    "esbuild": false
  }
}
